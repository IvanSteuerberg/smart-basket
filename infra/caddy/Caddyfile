# Serves the built React app and proxies the API (decision 0008).
# SITE_ADDRESS is ":80" on the laptop; on a server set it to the domain for automatic HTTPS.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle {
		root * /srv
		# The service worker and manifest must not be cached, or updates never arrive.
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html
		header @nocache Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
