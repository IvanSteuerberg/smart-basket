# Copy to .env (git-ignored) and change every password. Read by docker compose and the backend.

# PostgreSQL (db service)
POSTGRES_DB=smart_basket
POSTGRES_USER=smart_basket
POSTGRES_PASSWORD=change-me
# Read-only login for Metabase, limited to the bi schema
BI_READER_PASSWORD=change-me-too
# Owner of Metabase's own application database
METABASE_DB_PASSWORD=change-me-three

# Backend outside Docker (uv run ...): the db service publishes 127.0.0.1:5432
DATABASE_URL=postgresql+psycopg://smart_basket:change-me@localhost:5432/smart_basket

# LLM (decision 0005): ollama (native on the host), gemini (fallback) or none (rules only)
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:0.8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Routing (decision 0009): OpenStreetMap extract that covers León, downloaded on first start
VALHALLA_PBF_URL=https://download.geofabrik.de/europe/spain/castilla-y-leon-latest.osm.pbf
VALHALLA_THREADS=2

# Catalog ingestion (decision 0006): raw responses under DATA_DIR, comma-separated Mercadona
# warehouses and the pause between requests in seconds
DATA_DIR=data
MERCADONA_WAREHOUSES=3683
INGEST_DELAY_SECONDS=1.5

# Published ports and site address (":80" locally; a domain on a server enables HTTPS)
WEB_PORT=8080
SITE_ADDRESS=:80
DB_PORT=5432
ROUTING_PORT=8002
METABASE_PORT=3000
LOG_LEVEL=INFO
